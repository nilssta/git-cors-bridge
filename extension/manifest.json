{
  "manifest_version": 3,
  "name": "Git CORS Bridge",
  "version": "0.1.0",
  "description": "Lets a web app use git with GitHub, GitLab or any git server, which the browser's CORS rules block. You approve sites and servers.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_title": "Git CORS Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4b4a34af-4dde-4d9f-afc7-d302bd48b490}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
