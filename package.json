{
  "name": "git-cors-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Lets a web app use git with GitHub, GitLab or any git server, which the browser's CORS rules block. You approve sites and servers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node scripts/package.mjs && playwright test",
    "demo": "vite --host 127.0.0.1 --open /demo/",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "package": "node scripts/package.mjs",
    "lint:firefox": "node scripts/package.mjs && web-ext lint --source-dir dist/firefox",
    "browsers": "playwright install chromium && puppeteer browsers install firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24",
    "buffer": "6.0.3",
    "chrome-webstore-upload-cli": "4.0.2",
    "isomorphic-git": "1.44.3",
    "prettier": "3.9.9",
    "puppeteer": "^25.17.0",
    "typescript": "^5.9",
    "vite": "^8",
    "web-ext": "10.8.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
